# Ethereum RPC (Infura, Alchemy, etc.)
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Safe multisig address (owner of resolver + registry admin)
MULTISIG_ADDRESS=0xa28743bD38C9c951910d8FA9812c48ab5CDf75Ab

# Gateway trusted signer address
GATEWAY_SIGNER_ADDRESS=0xC9fACcf3a77b553375017efFEe441D9770fAA723
