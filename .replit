modules = ["nodejs-20"]
[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RWA-ID Gateway"

[[workflows.workflow]]
name = "RWA-ID Gateway"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd rwaid-gateway && npm install && node index.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd rwaid-gateway && npm install && node index.js"]
